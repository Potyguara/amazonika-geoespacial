# GEO-80B — compilação isolada da interface, com runtime de produção preservado.
# O build compila o código da worktree. A imagem final NÃO altera produção.
FROM node:22-bookworm-slim AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends coreutils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_API_URL=https://geo.amazonikaengenharia.com.br/api/v1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build

ARG BASE_WEB_IMAGE=amazonika-web-candidato:geo44-20261111
FROM ${BASE_WEB_IMAGE} AS runtime
# Mantenha as mesmas dependências/runtime da imagem estável; apenas o bundle é candidato.
COPY --from=build /app/dist /app/dist
