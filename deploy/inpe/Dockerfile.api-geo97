# GEO97 — overlay imutável: mantém API GEO90B da homologação.
ARG BASE_API_IMAGE=amazonika-api-inpe:geo90b-tiles
FROM ${BASE_API_IMAGE}
COPY backend/app/api/router.py /app/app/api/router.py
COPY backend/app/api/routes/official_overlaps.py /app/app/api/routes/official_overlaps.py
COPY backend/app/api/routes/tools.py /app/app/api/routes/tools.py
COPY backend/app/services/preliminary_pdf_stamp.py /app/app/services/preliminary_pdf_stamp.py
